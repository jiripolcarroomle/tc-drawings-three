{
  "name": "room-drawings",
  "version": "0.1.0",
  "private": true,
  "description": "Server-side vector drawings (top view, elevations) of furnished rooms from order data. No DOM, no WebGL, no runtime dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:update-golden": "UPDATE_GOLDEN=1 node --test \"test/**/*.test.ts\"",
    "preview": "node scripts/preview.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.3"
  }
}
